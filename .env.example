# 对象存储配置模板：复制为 .env 后填入自己的密钥
#
#   cp .env.example .env
#
# 注意：应用不会自动读取 .env，需要把变量注入进程环境，任选一种方式：
#   - Docker Compose：docker compose --env-file .env up -d（或在 compose 中配置 env_file: .env）
#   - 本地运行：set -a && source .env && set +a && uv run main.py
#
# 上传路由策略：按 COS -> OSS -> TOS 顺序判断，任一家配置齐全即使用；空值或占位符（如 xxx）视为未配置。
# 三家都未配置完整时，上传类接口（upload_file、gen_video 等）会直接报错。

# ========== 腾讯云 COS（优先级最高）==========
# 访问密钥：https://console.cloud.tencent.com/cam/capi
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=
COS_REGION=

# ========== 阿里云 OSS（COS 未配置时启用）==========
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# ========== 火山引擎 TOS（COS、OSS 均未配置时启用）==========
TOS_ACCESS_KEY_ID=
TOS_ACCESS_KEY_SECRET=
TOS_BUCKET_NAME=
TOS_REGION=
TOS_ENDPOINT=

# ========== 通用项（COS / OSS / TOS 共用）==========
# 对象存储上传目录前缀（根目录）
# 最终 object key 格式：[前缀/]yyyy-MM-dd/文件名；留空时文件落在桶根目录下的日期目录中，首尾多余的 / 会自动去除
#   留空             -> 2026-06-15/video.mp4
#   capcut-mate      -> capcut-mate/2026-06-15/video.mp4
#   prod/capcut-mate -> prod/capcut-mate/2026-06-15/video.mp4
STORAGE_UPLOAD_PREFIX=

# 上传后生成的签名下载 URL 有效期（天），默认 7，最小 1
VIDEO_GEN_RETENTION_DAYS=7
